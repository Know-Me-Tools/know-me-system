# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.temp
*.pid
*.seed
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Rust
target/
*.rs.bk

# Build-tool scratch locks (Gradle daemon, build_runner) — machine-local, never
# shared. Formerly a blanket `*.lock`, which also swallowed the dependency
# lockfiles below; those MUST be committed (see C-105 design doc).
*.gradle/**/*.lock
**/.dart_tool/build/lock/*.lock

# Dependency lockfiles ARE committed — this is an application workspace, not a
# library, so builds must be reproducible across machines and CI. This matters
# concretely here: native llama.cpp dependencies and optional Mistral/Liter-LLM
# providers must remain on reviewed revisions. Without these committed, CI can
# silently re-resolve and the build can break.
!rust/Cargo.lock
!desktop/src-tauri/Cargo.lock
!mobile/pubspec.lock
!mobile/ios/Podfile.lock
!flutter_packages/*/pubspec.lock

