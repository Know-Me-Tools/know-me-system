{
  "name": "KnowMe",
  "description": "A sovereign, on-device personal AI platform for macOS, Windows, Linux, iOS, and Android built from one Rust, React 19, and Flutter codebase.",
  "active_phase": null,
  "worktreeRoot": "${HOME}/.claude/worktrees",
  "maxChildDepth": 4,
  "ux_profile": "advanced",
  "__ux_profile_note": "advanced → kbd-status is dense by default; beginner → kbd-status --explain is on by default. Verbosity only — never gates information.",
  "spec_paths": [
    "openspec/specs/*.md",
    "docs/knowme-functional-spec.html",
    "docs/knowme-ui-ux-standard.md",
    "docs/implementation-roadmap.md"
  ],
  "openspec_available": true,
  "constraint_file": ".kbd-orchestrator/constraints.md",
  "build_health_command": "cd rust && cargo check --workspace && cd ../desktop && pnpm build && cd ../mobile && flutter analyze",
  "test_command": "cd rust && cargo test --workspace && cd ../desktop && pnpm test && cd ../mobile && flutter test",
  "lint_command": "cd rust && cargo clippy --workspace --all-targets -- -D warnings && cd ../desktop && pnpm lint && cd ../mobile && dart format --output=none --set-exit-if-changed .",
  "dev_command": "cd desktop && pnpm tauri:dev",
  "preferred_planning_agent": "antigravity",
  "preferred_execution_agents": [],
  "model_policy": {
    "registry": {
      "small": {
        "local": "Qwen3.5-9B-Q8_0",
        "t4": "Qwen3.5-9B-Q8_0",
        "l4": "Qwen3.5-9B-Q8_0"
      },
      "medium": {
        "local": null,
        "t4": "Qwen3.5-27B-Q4",
        "l4": "Qwen3.5-35B-A3B-Q4"
      },
      "frontier": {
        "local": "claude-sonnet-4-6",
        "t4": "claude-sonnet-4-6",
        "l4": "claude-sonnet-4-6"
      }
    },
    "phases": {
      "kbd-assess": "frontier",
      "kbd-plan": "frontier",
      "kbd-status": "small",
      "kbd-reflect": "frontier",
      "opsx-new": "small",
      "opsx-apply-low": "small",
      "opsx-apply-medium": "medium",
      "opsx-apply-high": "frontier",
      "opsx-verify": "medium",
      "opsx-archive": "small",
      "refiner-iterate": "small",
